  "tests": [
    {
      "description": "Player collects a coin by walking and jumping; counter text and variable update.",
      "lastRunAt": 1788216820400,
      "lastRunDurationMs": 221,
      "lastRunFramesExecuted": 72,
      "lastRunStatus": "passed",
      "name": "CoinCollection",
      "type": "gameplay",
      "source": [
        "await harness.goToScene('Cena sem título');",
        "await harness.stepFrames(5);",
        "const coinsBefore = harness.getObjects('Moeda').length;",
        "// Walk right, jumping periodically to climb the platforms toward the first coin (x≈344, y≈512)",
        "harness.setKeyPressed('Right', true);",
        "let collected = false;",
        "for (let i = 0; i < 30 && !collected; i++) {",
        "  harness.setKeyPressed('Space', true);",
        "  await harness.stepFrames(20);",
        "  harness.setKeyPressed('Space', false);",
        "  const done = await harness.stepUntil(() => harness.getObjects('Moeda').length < coinsBefore, { maxFrames: 20 });",
        "  if (done) collected = true;",
        "}",
        "harness.setKeyPressed('Right', false);",
        "harness.setKeyPressed('Space', false);",
        "harness.assert(collected, 'Player collected a coin by walking and jumping right');",
        "const counter = harness.getObjects('ContadorMoedas')[0];",
        "harness.assert(counter && counter.text === 'Moedas: 1', 'Counter shows Moedas: 1, got: ' + (counter ? counter.text : 'missing'));",
        "const scoreVar = harness.getSceneVariable('MoedasColetadas');",
        "harness.assert(scoreVar && scoreVar.value === 1, 'Variable MoedasColetadas = 1, got ' + (scoreVar && scoreVar.value));"
      ]
    }
  ],
