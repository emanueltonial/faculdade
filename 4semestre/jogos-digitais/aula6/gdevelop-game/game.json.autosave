color":"255;255;255","shadowQuality":"medium","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]},{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"UI","renderingType":"","visibility":true,"cameras":[],"effects":[]}],"behaviorsSharedData":[{"name":"Animation","type":"AnimatableCapability::AnimatableBehavior"},{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Flippable","type":"FlippableCapability::FlippableBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Platform","type":"PlatformBehavior::PlatformBehavior"},{"name":"PlatformerObject","type":"PlatformBehavior::PlatformerObjectBehavior"},{"name":"Resizable","type":"ResizableCapability::ResizableBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"Text","type":"TextContainerCapability::TextContainerBehavior"}]}],"externalEvents":[],"tests":[{"description":"Player collects a coin by walking and jumping; counter text and variable update.","lastRunAt":1788216820400.0,"lastRunDurationMs":221.0,"lastRunFramesExecuted":72,"lastRunStatus":"passed","name":"CoinCollection","type":"gameplay","source":["await harness.goToScene('Cena sem título');","await harness.stepFrames(5);","const coinsBefore = harness.getObjects('Moeda').length;","// Walk right, jumping periodically to climb the platforms toward the first coin (x≈344, y≈512)","harness.setKeyPressed('Right', true);","let collected = false;","for (let i = 0; i < 30 && !collected; i++) {","  harness.setKeyPressed('Space', true);","  await harness.stepFrames(20);","  harness.setKeyPressed('Space', false);","  const done = await harness.stepUntil(() => harness.getObjects('Moeda').length < coinsBefore, { maxFrames: 20 });","  if (done) collected = true;","}","harness.setKeyPressed('Right', false);","harness.setKeyPressed('Space', false);","harness.assert(collected, 'Player collected a coin by walking and jumping right');","const counter = harness.getObjects('ContadorMoedas')[0];","harness.assert(counter && counter.text === 'Moedas: 1', 'Counter shows Moedas: 1, got: ' + (counter ? counter.text : 'missing'));","const scoreVar = harness.getSceneVariable('MoedasColetadas');","harness.assert(scoreVar && scoreVar.value === 1, 'Variable MoedasColetadas = 1, got ' + (scoreVar && scoreVar.value));"]}],"eventsFunctionsExtensions":[],"externalLayouts":[]}